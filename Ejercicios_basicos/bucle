# 1. Solicitamos la cantidad total de pasajes al usuario
# Usamos int() para convertir el texto que escribe el usuario en un número entero
total_pasajes = int(input("¿Cuántos pasajes deseas vender?: "))

# 2. Inicializamos el acumulador en 0
# Esta variable guardará la suma de todos los precios que ingresaremos
total_ingresos = 0

# 3. Iniciamos el bucle 'for'
# range(total_pasajes) hará que el bloque de adentro se repita esa cantidad de veces
for i in range(total_pasajes):
    try:
        # Pedimos el precio de cada pasaje individualmente
        # i + 1 es solo para mostrar "Pasaje 1", "Pasaje 2", etc.
        precio = int(input(f"Ingrese el precio del pasaje {i + 1}: "))
        
        # 4. Acumulamos el valor
        # total_ingresos += precio es lo mismo que decir:
        # total_ingresos = total_ingresos + precio
        total_ingresos += precio
        
    except ValueError:
        # 5. Manejo de errores
        # Si el usuario escribe letras en lugar de números, se ejecuta esto:
        print("Error: Necesitas proporcionar un valor numérico válido.")
        
        # La instrucción 'break' detiene el bucle inmediatamente
        break

# 6. Resultado final
# Esta línea está fuera del bucle (sin sangría), por lo que solo se ejecuta al terminar
print("------------------------------------------")
print(f"Monto total obtenido por la venta: {total_ingresos}")
